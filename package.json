{
  "name": "the-sound-she-carries",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/api\"",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/api",
    "db:migrate": "npm run db:migrate --prefix apps/api",
    "db:seed": "npm run db:seed --prefix apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "apps/*"
  ]
}
